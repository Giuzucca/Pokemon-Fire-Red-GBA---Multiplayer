diff --git a/include/multiplayer.h b/include/multiplayer.h
new file mode 100644
index 0000000..b222a39
--- /dev/null
+++ b/include/multiplayer.h
@@ -0,0 +1,103 @@
+#ifndef GUARD_MULTIPLAYER_H
+#define GUARD_MULTIPLAYER_H
+
+#define MP_MAGIC 0x504D5246
+#define MP_VERSION 3
+#define MP_LOCAL_ID 254
+#define MP_INVITATION_COOP 0x40000000
+#define MP_INVITATION_TRAINER 0x20000000
+#define MP_INVITATION_REMATCH 0x10000000
+#define MP_INVITATION_TOWER 0x08000000
+#define MP_INVITATION_TOWER_DOUBLE 0x04000000
+
+// Fixed ABI shared with the emulator bridge; all multibyte values little endian.
+struct MultiplayerPosition
+{
+    u8 ready;
+    u8 mapGroup;
+    u8 mapNum;
+    u8 direction;
+    u16 x;
+    u16 y;
+    u8 elevation;
+    u8 gender;
+    u8 avatarFlags;
+    u8 reserved;
+};
+
+struct MultiplayerMailbox
+{
+    u32 magic;
+    u16 version;
+    u16 size;
+    u32 frame;
+    u8 connected;
+    u8 remoteObjectId;
+    u8 reserved[2];
+    struct MultiplayerPosition local;
+    struct MultiplayerPosition remote;
+    u32 rxSequence; // bridge writes this last
+    u32 invitation;
+    u32 remoteInvitation;
+    u8 inviteState;
+    u8 remoteInviteState;
+    u8 role; // 1 host, 2 client; assigned by the bridge
+    u8 inviteResult; // 0 cancelled, 1 declined, 2 agreed
+    u32 duelId;
+    u32 remoteDuelId;
+    u32 txSequence;
+    u32 txAck;
+    u16 txSize;
+    u8 duelPhase; // 0 idle, 1 metadata, 2 battle, 3 closing, 4 finished
+    u8 remoteDuelPhase;
+    u8 recvMask;
+    u8 duelOutcome;
+    u8 abortReason;
+    u8 padding;
+    u16 recvSize[2];
+};
+
+extern volatile struct MultiplayerMailbox gMultiplayer;
+void MultiplayerFrame(void);
+void MultiplayerOverworld(void);
+void MultiplayerRemoveRemote(void);
+const u8 *MultiplayerInteractionScript(void);
+bool8 MultiplayerDuelActive(void);
+bool8 MultiplayerHasUsableParty(void);
+void MultiplayerDuelFrame(void);
+void MultiplayerEndDuel(void);
+bool8 MultiplayerSendBlock(const void *src, u16 size);
+bool8 MultiplayerLinkIdle(void);
+bool8 MultiplayerValidateBattleBlock(u8 player);
+// Development entry point, deliberately not exposed by the field menus yet.
+void MultiplayerPrepareCoopTrial(void);
+bool8 MultiplayerCoopActive(void);
+struct Pokemon;
+struct Pokemon *MultiplayerPartyForBattler(u8 battler);
+bool8 MultiplayerOwnsBattler(u8 battler);
+void MultiplayerResetRewards(void);
+void MultiplayerTrackParticipants(void);
+void MultiplayerRecordDefeat(u8 battler);
+void MultiplayerCommitRewards(void (*callback)(void));
+void MultiplayerSnapshotInventory(void);
+void MultiplayerFinishInventory(bool8 commit);
+void MultiplayerStageCapture(void);
+void MultiplayerResetItemChoice(void);
+void MultiplayerRecordItemChoice(u16 item, u8 partyIndex, u8 moveIndex);
+void MultiplayerEmitItemChoice(u16 item);
+void MultiplayerApplyRemoteItemChoice(void);
+bool8 MultiplayerReceiveItemState(void);
+bool8 MultiplayerTryWildInvitation(void);
+bool8 MultiplayerTryTrainerInvitation(u16 trainerId);
+bool8 MultiplayerTryRematchInvitation(u16 trainerId);
+bool8 MultiplayerTryTowerInvitation(void);
+bool8 MultiplayerIsCoopInvitation(void);
+bool8 MultiplayerIsEncounterOwner(void);
+bool8 MultiplayerIsTrainerInvitation(void);
+bool8 MultiplayerIsRematchInvitation(void);
+bool8 MultiplayerIsTowerInvitation(void);
+void MultiplayerResumeTrainerBattle(void);
+void MultiplayerResumeRematchBattle(void);
+void MultiplayerResumeTrainerTowerBattle(void);
+
+#endif
