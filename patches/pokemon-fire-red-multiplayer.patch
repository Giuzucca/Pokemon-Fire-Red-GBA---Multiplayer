+
+// Must survive CB2_InitBattle's heap reset. No party data is written to flash.
+static EWRAM_DATA struct Pokemon sDuelParty[PARTY_SIZE] = {0};
+static EWRAM_DATA struct Pokemon sRemoteParty[PARTY_SIZE] = {0};
+static EWRAM_DATA u8 sDuelPartyCount = 0;
+static EWRAM_DATA bool8 sBattleAllocated = FALSE;
+static EWRAM_DATA u32 sDuelStarted = 0;
+static EWRAM_DATA u32 sTxStarted = 0;
+static EWRAM_DATA MainCallback sFieldCallback = NULL;
+static EWRAM_DATA bool8 sCoopTrial = FALSE;
+
+static void CB2_FinishDuel(void);
+static void CB2_FinishCoopRewards(void);
+static void CB2_StartDuelBattle(void);
+static void Task_PrepareDuel(u8 taskId);
+
+void MultiplayerPrepareCoopTrial(void)
+{
+    if (!MultiplayerDuelActive())
+        sCoopTrial = TRUE;
+}
+
+bool8 MultiplayerCoopActive(void)
+{
+    return sCoopTrial && MultiplayerDuelActive();
+}
+
+bool8 MultiplayerOwnsBattler(u8 battler)
+{
+    return !MultiplayerCoopActive() || battler == (gMultiplayer.role - 1) * 2;
+}
+
+struct Pokemon *MultiplayerPartyForBattler(u8 battler)
+{
+    if (MultiplayerCoopActive() && !(battler & 1) && !MultiplayerOwnsBattler(battler))
+        return sRemoteParty;
+    return gPlayerParty;
+}
+
+bool8 MultiplayerDuelActive(void)
+{
+    return gMultiplayer.duelPhase >= 1 && gMultiplayer.duelPhase <= 3;
+}
+
+bool8 MultiplayerHasUsableParty(void)
+{
+    u8 i;
+    for (i = 0; i < gPlayerPartyCount && i < PARTY_SIZE; i++)
+        if (GetMonData(&gPlayerParty[i], MON_DATA_SPECIES)
+         && !GetMonData(&gPlayerParty[i], MON_DATA_IS_EGG)
+         && GetMonData(&gPlayerParty[i], MON_DATA_HP))
+            return TRUE;
+    return FALSE;
+}
+
+bool8 MultiplayerLinkIdle(void)
+{
+    return gMultiplayer.txSequence == gMultiplayer.txAck
+        && !(gMultiplayer.recvMask & (1 << (gMultiplayer.role - 1)));
+}
+
+bool8 MultiplayerSendBlock(const void *src, u16 size)
+{
+    u8 id = gMultiplayer.role - 1;
+    u16 ime;
+    if (!size || size > BLOCK_BUFFER_SIZE)
+    {
+        gMultiplayer.abortReason = 3;
+        return FALSE;
+    }
+    if (!MultiplayerLinkIdle())
+        return FALSE;
+    ime = REG_IME;
+    REG_IME = 0; // Native receive processing runs in VBlank.
+    memcpy(gBlockSendBuffer, src, size);
+    memcpy(gBlockRecvBuffer[id], src, size);
+    gMultiplayer.recvSize[id] = size;
+    gMultiplayer.recvMask |= 1 << id;
+    gMultiplayer.txSize = size;
+    sTxStarted = gMultiplayer.frame;
+    gMultiplayer.txSequence++;
+    REG_IME = ime;
+    return TRUE;
+}
+
+bool8 MultiplayerValidateBattleBlock(u8 player)
+{
+    u8 *data = (u8 *)gBlockRecvBuffer[player];
+    u16 payload = data[4] | (data[5] << 8);
+    if (gMultiplayer.recvSize[player] < 12 || payload < 4 || payload > 248
+     || payload + 8 != gMultiplayer.recvSize[player] || data[0] > 2
+     || data[1] >= (sCoopTrial ? 4 : 2) || data[2] >= 4 || data[3] >= 4 || data[7] >= 4
+     || (data[0] == 2 && data[8] >= 2)
+     || (sCoopTrial && data[0] == 1 && data[8] == CONTROLLER_ONERETURNVALUE
+         && data[11] == 0x4D && (payload < 8 || data[12] > PARTY_SIZE || data[13] >= MAX_MON_MOVES))
+     || (sCoopTrial && data[0] == 0 && data[8] == CONTROLLER_SETMONDATA
+         && data[9] == 0xFE && (payload < 3 + sizeof(struct Pokemon) + sizeof(struct BattlePokemon)
+                              || data[10] >= PARTY_SIZE))
+     || (sCoopTrial && data[0] == 0 && data[8] == CONTROLLER_OPENBAG
+         && payload < 4 + sizeof(struct BattlePokemon) + sizeof(struct SideTimer)))
+    {
+        gMultiplayer.abortReason = 3;
+        return FALSE;
+    }
+    return TRUE;
+}
+
+void MultiplayerStartDuel(void)
+{
+    u8 id = gMultiplayer.role - 1;
+    u8 task;
+    if (MultiplayerIsCoopInvitation())
+        sCoopTrial = TRUE;
+    gMultiplayer.duelOutcome = 0;
+    gMultiplayer.abortReason = 0;
+    memcpy(sDuelParty, gPlayerParty, sizeof(sDuelParty));
+    sDuelPartyCount = gPlayerPartyCount;
+    sFieldCallback = gMain.callback1;
+    sBattleAllocated = FALSE;
+    MultiplayerResetRewards();
+    MultiplayerSnapshotInventory();
+    sDuelStarted = gMultiplayer.frame;
+    gMultiplayer.duelId = gMultiplayer.invitation;
+    gMultiplayer.duelPhase = 1;
+    gMultiplayer.txSequence = 0;
+    gMultiplayer.txAck = 0;
+    gMultiplayer.txSize = 0;
+    gMultiplayer.recvMask = 0;
+    gMultiplayer.recvSize[0] = gMultiplayer.recvSize[1] = 0;
+    if (!gMultiplayer.connected || id > 1 || !MultiplayerHasUsableParty()
+     || gMultiplayer.inviteState != 7 || !gMultiplayer.invitation
+     || gMultiplayer.remoteInvitation != gMultiplayer.invitation
+     || (gMultiplayer.remoteInviteState != 6 && gMultiplayer.remoteInviteState != 7))
+    {
+        gMultiplayer.abortReason = 1;
+        return;
+    }
+    memset(gLinkPlayers, 0, sizeof(gLinkPlayers));
+    gLinkPlayers[id].version = GAME_VERSION;
+    memcpy(&gLinkPlayers[id].trainerId, gSaveBlock2Ptr->playerTrainerId, 4);
+    memcpy(gLinkPlayers[id].name, gSaveBlock2Ptr->playerName, PLAYER_NAME_LENGTH);
+    gLinkPlayers[id].name[PLAYER_NAME_LENGTH] = EOS;
+    gLinkPlayers[id].gender = gSaveBlock2Ptr->playerGender;
+    gLinkPlayers[id].linkType = LINKTYPE_BATTLE;
+    gLinkPlayers[id].id = id;
+    gLinkPlayers[id].language = GAME_LANGUAGE;
+    gLinkPlayers[id].neverRead = sCoopTrial;
+    gLocalLinkPlayerId = id;
+    gWirelessCommType = 0;
+    gLinkType = LINKTYPE_BATTLE;
+    gReceivedRemoteLinkPlayers = FALSE;
+    MultiplayerRemoveRemote();
+    FadeScreen(FADE_TO_BLACK, 0);
+    task = CreateTask(Task_PrepareDuel, 0);
+    if (task == 0xFF)
+        gMultiplayer.abortReason = 1;
+}
+
+static void Task_PrepareDuel(u8 taskId)
+{
+    u8 id = gMultiplayer.role - 1;
+    u8 other = id ^ 1;
+    if (gPaletteFade.active)
+        return;
+    if (gTasks[taskId].data[0] == 0)
+    {
+        if (MultiplayerSendBlock(&gLinkPlayers[id], sizeof(struct LinkPlayer)))
+            gTasks[taskId].data[0] = 1;
+    }
+    else if (gTasks[taskId].data[0] == 1 && gMultiplayer.recvMask == 3 && gMultiplayer.txAck == gMultiplayer.txSequence)
+    {
+        if (gMultiplayer.recvSize[other] != sizeof(struct LinkPlayer))
+        {
+            gMultiplayer.abortReason = 3;
+            return;
+        }
+        memcpy(&gLinkPlayers[other], gBlockRecvBuffer[other], sizeof(struct LinkPlayer));
+        if (gLinkPlayers[other].version != GAME_VERSION || gLinkPlayers[other].id != other
+         || gLinkPlayers[other].gender > 1 || gLinkPlayers[other].linkType != LINKTYPE_BATTLE
+         || gLinkPlayers[other].neverRead != sCoopTrial)
+        {
+            gMultiplayer.abortReason = 3;
+            return;
+        }
+        gLinkPlayers[other].name[PLAYER_NAME_LENGTH] = EOS;
+        gMultiplayer.recvMask = 0;
+        gTasks[taskId].data[0] = sCoopTrial ? 2 : 6;
+    }
+    else if (gTasks[taskId].data[0] == 2)
+    {
+        u8 offset = gTasks[taskId].data[1] * 2;
+        if (MultiplayerSendBlock(&sDuelParty[offset], sizeof(struct Pokemon) * 2))
+            gTasks[taskId].data[0] = 3;
+    }
+    else if (gTasks[taskId].data[0] == 3 && gMultiplayer.recvMask == 3
+          && gMultiplayer.txAck == gMultiplayer.txSequence)
+    {
+        u8 offset = gTasks[taskId].data[1] * 2;
+        if (gMultiplayer.recvSize[other] != sizeof(struct Pokemon) * 2)
+        {
+            gMultiplayer.abortReason = 3;
+            return;
+        }
+        memcpy(&sRemoteParty[offset], gBlockRecvBuffer[other], sizeof(struct Pokemon) * 2);
+        gMultiplayer.recvMask = 0;
+        if (++gTasks[taskId].data[1] == 3)
+        {
+            gTasks[taskId].data[1] = 0;
+            gTasks[taskId].data[0] = 4;
+        }
+        else
+            gTasks[taskId].data[0] = 2;
+    }
+    else if (gTasks[taskId].data[0] == 4)
+    {
+        u8 offset = gTasks[taskId].data[1] * 2;
+        if (MultiplayerSendBlock(&gEnemyParty[offset], sizeof(struct Pokemon) * 2))
+            gTasks[taskId].data[0] = 5;
+    }
+    else if (gTasks[taskId].data[0] == 5 && gMultiplayer.recvMask == 3
+          && gMultiplayer.txAck == gMultiplayer.txSequence)
+    {
+        u8 owner = gMultiplayer.duelId & 1;
+        u8 offset = gTasks[taskId].data[1] * 2;
+        if (gMultiplayer.recvSize[owner] != sizeof(struct Pokemon) * 2)
+        {
+            gMultiplayer.abortReason = 3;
+            return;
+        }
+        memcpy(&gEnemyParty[offset], gBlockRecvBuffer[owner], sizeof(struct Pokemon) * 2);
+        gMultiplayer.recvMask = 0;
+        if (++gTasks[taskId].data[1] < PARTY_SIZE / 2)
+        {
+            gTasks[taskId].data[0] = 4;
+            return;
+        }
+        if (!GetMonData(&gEnemyParty[0], MON_DATA_HP))
+        {
+            gMultiplayer.abortReason = 1;
+            return;
+        }
+        gTasks[taskId].data[0] = 6;
+    }
+    else if (gTasks[taskId].data[0] == 6)
+    {
+        gMultiplayer.duelPhase = 2;
+        sDuelStarted = gMultiplayer.frame;
+        gReceivedRemoteLinkPlayers = TRUE;
+        gBattleTypeFlags = BATTLE_TYPE_TRAINER | BATTLE_TYPE_LINK;
+        if (sCoopTrial)
+        {
+            gBattleTypeFlags = BATTLE_TYPE_LINK | BATTLE_TYPE_DOUBLE
+                            | (id == 0 ? BATTLE_TYPE_IS_MASTER : 0);
+            if (MultiplayerIsTrainerInvitation())
+                gBattleTypeFlags |= BATTLE_TYPE_TRAINER;
+            if (MultiplayerIsTowerInvitation())
+            {
+                gBattleTypeFlags |= BATTLE_TYPE_TRAINER_TOWER;
+                if (gMultiplayer.invitation & MP_INVITATION_TOWER_DOUBLE)
+                    gBattleTypeFlags |= BATTLE_TYPE_DOUBLE;
+            }
+            gLinkPlayers[1].id = 2; // The second human owns the allied right slot.
+        }
+        if (MultiplayerIsTrainerInvitation())
+            gTrainerBattleOpponent_A = (gMultiplayer.invitation >> 16) & 0x1FFF;
+        else
+            gTrainerBattleOpponent_A = TRAINER_LINK_OPPONENT;
+        gMain.savedCallback = CB2_FinishDuel;
+        PlayMapChosenOrBattleBGM(MUS_RS_VS_TRAINER);
+        CleanupOverworldWindowsAndTilemaps();
+        DestroyTask(taskId);
+        SetMainCallback2(CB2_StartDuelBattle);
+    }
+}
+
+static void CB2_StartDuelBattle(void)
+{
+    // CB2_InitBattle resets tasks and the heap, but preserves static backup.
+    CB2_InitBattle();
+    sBattleAllocated = TRUE;
+}
+
+void MultiplayerEndDuel(void)
+{
+    // Continue servicing battle tasks until both controllers have finished.
+    if (gMultiplayer.duelPhase != 3)
+        sDuelStarted = gMultiplayer.frame;
+    gMultiplayer.duelPhase = 3;
+    gMultiplayer.duelOutcome = gBattleOutcome;
+}
+
+void MultiplayerDuelFrame(void)
+{
+    bool8 same;
+    if (!MultiplayerDuelActive())
+        return;
+    if (sCoopTrial && sBattleAllocated && (gBattleTypeFlags & BATTLE_TYPE_LINK_IN_BATTLE))
+        MultiplayerTrackParticipants();
+    same = gMultiplayer.remoteDuelId == gMultiplayer.duelId;
+    if (!gMultiplayer.connected)
+        gMultiplayer.abortReason = 2;
+    if ((gMultiplayer.duelPhase == 1 && gMultiplayer.frame - sDuelStarted > 1800)
+     || (gMultiplayer.duelPhase == 2 && !(gBattleTypeFlags & BATTLE_TYPE_LINK_IN_BATTLE)
+         && gMultiplayer.frame - sDuelStarted > 1800)
+     || (gMultiplayer.duelPhase == 3 && gMultiplayer.frame - sDuelStarted > 600)
+     || (gMultiplayer.txSequence != gMultiplayer.txAck && gMultiplayer.frame - sTxStarted > 600))
+        gMultiplayer.abortReason = 2;
+    if (same && gMultiplayer.remoteDuelPhase == 4 && gMultiplayer.duelPhase != 3)
+        gMultiplayer.abortReason = 2;
+    if (gMultiplayer.abortReason
+     || (gMultiplayer.duelPhase == 3 && same && gMultiplayer.remoteDuelPhase >= 3))
+    {
+        gMain.callback1 = NULL;
+        SetMainCallback2(CB2_FinishDuel);
+    }
+}
+
+static void CB2_FinishDuel(void)
+{
+    bool8 persist = sCoopTrial && MultiplayerIsCoopInvitation() && !gMultiplayer.abortReason;
+    gReceivedRemoteLinkPlayers = FALSE;
+    gBattleTypeFlags &= ~BATTLE_TYPE_LINK_IN_BATTLE;
+    SetVBlankCallback(NULL);
+    SetHBlankCallback(NULL);
+    ResetTasks();
+    if (sBattleAllocated)
+    {
+        FreeRestoreBattleData();
+        sBattleAllocated = FALSE;
+    }
+    FreeAllWindowBuffers();
+    if (!persist)
+        memcpy(gPlayerParty, sDuelParty, sizeof(sDuelParty));
+    gPlayerPartyCount = sDuelPartyCount;
+    MultiplayerFinishInventory(persist);
+    gMain.inBattle = FALSE;
+    gMain.callback1 = sFieldCallback;
+    gReceivedRemoteLinkPlayers = FALSE;
+    gLinkType = 0;
+    gMultiplayer.duelPhase = 4;
+    gMultiplayer.recvMask = 0;
+    sCoopTrial = FALSE;
+    gSpecialVar_Result = gMultiplayer.abortReason ? 0 : gMultiplayer.duelOutcome;
+    if (persist)
+    {
+        gMain.callback1 = NULL;
+        MultiplayerCommitRewards(CB2_FinishCoopRewards);
+    }
+    else
+        CB2_FinishCoopRewards();
+}
+
+static void CB2_FinishCoopRewards(void)
+{
+    if (MultiplayerIsTrainerInvitation() && !MultiplayerIsTowerInvitation()
+     && MultiplayerIsEncounterOwner()
+     && !gMultiplayer.abortReason && gBattleOutcome == B_OUTCOME_WON)
+    {
+        SetTrainerFlag(gTrainerBattleOpponent_A);
+        if (MultiplayerIsRematchInvitation())
+            ClearRematchStateOfLastTalked();
+    }
+    gBattleTypeFlags = 0;
+    gMain.callback1 = sFieldCallback;
+    SetMainCallback2(CB2_ReturnToFieldContinueScriptPlayMapMusic);
+}
diff --git a/src/multiplayer_capture.c b/src/multiplayer_capture.c
new file mode 100644
index 0000000..b93012b
--- /dev/null
+++ b/src/multiplayer_capture.c
@@ -0,0 +1,60 @@
+#include "global.h"
+#include "multiplayer.h"
+#include "battle.h"
+#include "battle_controllers.h"
+#include "pokemon.h"
+#include "pokeball.h"
+#include "pokedex.h"
+#include "overworld.h"
+#include "constants/game_stat.h"
+
+static EWRAM_DATA struct ItemSlot sInventory[BAG_ITEMS_COUNT + BAG_POKEBALLS_COUNT + BAG_BERRIES_COUNT] = {0};
+static EWRAM_DATA u16 sInventoryKey = 0;
+static EWRAM_DATA struct Pokemon sCaughtMon = {0};
+static EWRAM_DATA bool8 sCaughtPending = FALSE;
+
+void MultiplayerSnapshotInventory(void)
+{
+    memcpy(sInventory, gSaveBlock1Ptr->bagPocket_Items, sizeof(gSaveBlock1Ptr->bagPocket_Items));
+    memcpy(sInventory + BAG_ITEMS_COUNT, gSaveBlock1Ptr->bagPocket_PokeBalls, sizeof(gSaveBlock1Ptr->bagPocket_PokeBalls));
+    memcpy(sInventory + BAG_ITEMS_COUNT + BAG_POKEBALLS_COUNT, gSaveBlock1Ptr->bagPocket_Berries, sizeof(gSaveBlock1Ptr->bagPocket_Berries));
+    sInventoryKey = gSaveBlock2Ptr->encryptionKey;
+    sCaughtPending = FALSE;
+}
+
+void MultiplayerStageCapture(void)
+{
+    u8 target = gBattleBufferA[gActiveBattler][2];
+    u16 ball = gBattleBufferA[gActiveBattler][4] | gBattleBufferA[gActiveBattler][5] << 8;
+    if (!MultiplayerCoopActive() || !MultiplayerOwnsBattler(gActiveBattler)
+     || gBattleBufferA[gActiveBattler][1] != BALL_3_SHAKES_SUCCESS || target >= MAX_BATTLERS_COUNT
+     || gBattlerPartyIndexes[target] >= PARTY_SIZE || sCaughtPending)
+        return;
+    memcpy(&sCaughtMon, &gEnemyParty[gBattlerPartyIndexes[target]], sizeof(sCaughtMon));
+    SetMonData(&sCaughtMon, MON_DATA_POKEBALL, &ball);
+    sCaughtPending = TRUE;
+}
+
+void MultiplayerFinishInventory(bool8 commit)
+{
+    u16 i;
+    if (!commit)
+    {
+        u16 difference = sInventoryKey ^ gSaveBlock2Ptr->encryptionKey;
+        for (i = 0; i < ARRAY_COUNT(sInventory); i++)
+            sInventory[i].quantity ^= difference;
+        memcpy(gSaveBlock1Ptr->bagPocket_Items, sInventory, sizeof(gSaveBlock1Ptr->bagPocket_Items));
+        memcpy(gSaveBlock1Ptr->bagPocket_PokeBalls, sInventory + BAG_ITEMS_COUNT, sizeof(gSaveBlock1Ptr->bagPocket_PokeBalls));
+        memcpy(gSaveBlock1Ptr->bagPocket_Berries, sInventory + BAG_ITEMS_COUNT + BAG_POKEBALLS_COUNT, sizeof(gSaveBlock1Ptr->bagPocket_Berries));
+    }
+    else if (sCaughtPending)
+    {
+        u16 species = GetMonData(&sCaughtMon, MON_DATA_SPECIES);
+        u32 personality = GetMonData(&sCaughtMon, MON_DATA_PERSONALITY);
+        GiveMonToPlayer(&sCaughtMon);
+        HandleSetPokedexFlag(SpeciesToNationalPokedexNum(species), FLAG_SET_SEEN, personality);
+        HandleSetPokedexFlag(SpeciesToNationalPokedexNum(species), FLAG_SET_CAUGHT, personality);
+        IncrementGameStat(GAME_STAT_POKEMON_CAPTURES);
+    }
+    sCaughtPending = FALSE;
+}
diff --git a/src/multiplayer_items.c b/src/multiplayer_items.c
new file mode 100644
index 0000000..bdd40de
--- /dev/null
+++ b/src/multiplayer_items.c
@@ -0,0 +1,86 @@
+#include "global.h"
+#include "multiplayer.h"
+#include "battle.h"
+#include "battle_controllers.h"
+#include "battle_anim.h"
+#include "battle_interface.h"
+#include "battle_util.h"
+#include "pokemon.h"
+
+static EWRAM_DATA u16 sChosenItem = 0;
+static EWRAM_DATA u8 sChosenPartyIndex = PARTY_SIZE;
+static EWRAM_DATA u8 sChosenMoveIndex = 0;
+
+void MultiplayerResetItemChoice(void)
+{
+    sChosenItem = 0;
+    sChosenPartyIndex = PARTY_SIZE;
+    sChosenMoveIndex = 0;
+}
+
+void MultiplayerRecordItemChoice(u16 item, u8 partyIndex, u8 moveIndex)
+{
+    sChosenItem = item;
+    sChosenPartyIndex = partyIndex;
+    sChosenMoveIndex = moveIndex;
+}
+
+void MultiplayerEmitItemChoice(u16 item)
+{
+    u8 data[8];
+    data[0] = CONTROLLER_ONERETURNVALUE;
+    data[1] = item;
+    data[2] = item >> 8;
+    data[3] = 0x4D;
+    data[4] = item != 0 && item == sChosenItem ? sChosenPartyIndex : PARTY_SIZE;
+    data[5] = sChosenMoveIndex;
+    data[6] = 0;
+    data[7] = 0;
+    PrepareBufferDataTransferLink(1, sizeof(data), data);
+}
+
+void MultiplayerApplyRemoteItemChoice(void)
+{
+    u8 menuBattler;
+    u8 slot;
+    u8 move;
+    u16 item;
+    u8 data[sizeof(struct Pokemon) + sizeof(struct BattlePokemon)];
+    if (!MultiplayerCoopActive() || GetBattlerSide(gActiveBattler) != B_SIDE_PLAYER
+     || gBattleBufferB[gActiveBattler][3] != 0x4D)
+        return;
+    slot = gBattleBufferB[gActiveBattler][4];
+    move = gBattleBufferB[gActiveBattler][5];
+    if (slot >= PARTY_SIZE || move >= MAX_MON_MOVES)
+        return;
+    item = gBattleBufferB[gActiveBattler][1] | gBattleBufferB[gActiveBattler][2] << 8;
+    if (!MultiplayerOwnsBattler(gActiveBattler))
+    {
+        menuBattler = gBattlerInMenuId;
+        gBattlerInMenuId = gActiveBattler;
+        // The owner's Bag already applied the effect and consumed the item.
+        // Replay only on the remote party, without consuming host inventory.
+        PokemonUseItemEffects(&MultiplayerPartyForBattler(gActiveBattler)[slot], item, slot, move, FALSE);
+        gBattlerInMenuId = menuBattler;
+    }
+    memcpy(data, &MultiplayerPartyForBattler(gActiveBattler)[slot], sizeof(struct Pokemon));
+    memcpy(data + sizeof(struct Pokemon), &gBattleMons[gActiveBattler], sizeof(struct BattlePokemon));
+    BtlController_EmitSetMonData(0, 0xFE, slot, sizeof(data), data);
+    MarkBattlerForControllerExec(gActiveBattler);
+}
+
+bool8 MultiplayerReceiveItemState(void)
+{
+    u8 slot;
+    struct Pokemon *party;
+    if (!MultiplayerCoopActive() || gBattleBufferA[gActiveBattler][1] != 0xFE)
+        return FALSE;
+    slot = gBattleBufferA[gActiveBattler][2];
+    if (slot >= PARTY_SIZE)
+        return TRUE;
+    party = MultiplayerPartyForBattler(gActiveBattler);
+    memcpy(&party[slot], &gBattleBufferA[gActiveBattler][3], sizeof(struct Pokemon));
+    memcpy(&gBattleMons[gActiveBattler], &gBattleBufferA[gActiveBattler][3 + sizeof(struct Pokemon)], sizeof(struct BattlePokemon));
+    UpdateHealthboxAttribute(gHealthboxSpriteIds[gActiveBattler], &party[gBattlerPartyIndexes[gActiveBattler]], HEALTHBOX_ALL);
+    return TRUE;
+}
diff --git a/src/multiplayer_rewards.c b/src/multiplayer_rewards.c
new file mode 100644
index 0000000..e9fb329
--- /dev/null
+++ b/src/multiplayer_rewards.c
@@ -0,0 +1,197 @@
+#include "global.h"
+#include "multiplayer.h"
+#include "battle.h"
+#include "battle_main.h"
+#include "pokemon.h"
+#include "pokemon_summary_screen.h"
+#include "evolution_scene.h"
+#include "item.h"
+#include "main.h"
+#include "palette.h"
+#include "constants/hold_effects.h"
+#include "constants/items.h"
+#include "constants/moves.h"
+
+// Rewards are local and deferred until a completed cooperative battle returns.
+// Never put either player's rewards into the other player's campaign.
+static EWRAM_DATA u8 sParticipants[PARTY_SIZE] = {0};
+static EWRAM_DATA u16 sDefeatedSpecies[PARTY_SIZE] = {0};
+static EWRAM_DATA u8 sDefeatedLevel[PARTY_SIZE] = {0};
+static EWRAM_DATA u32 sExperience[PARTY_SIZE] = {0};
+static EWRAM_DATA u8 sRewardSlot = 0;
+static EWRAM_DATA u8 sRewardState = 0;
+static EWRAM_DATA bool8 sFirstMove = FALSE;
+static EWRAM_DATA bool8 sLeveled = FALSE;
+static EWRAM_DATA MainCallback sRewardCallback = NULL;
+
+static void CB2_Rewards(void);
+
+void MultiplayerResetRewards(void)
+{
+    memset(sParticipants, 0, sizeof(sParticipants));
+    memset(sDefeatedSpecies, 0, sizeof(sDefeatedSpecies));
+    memset(sDefeatedLevel, 0, sizeof(sDefeatedLevel));
+    memset(sExperience, 0, sizeof(sExperience));
+}
+
+void MultiplayerTrackParticipants(void)
+{
+    u8 own = (gMultiplayer.role - 1) * 2;
+    u8 slot = gBattlerPartyIndexes[own];
+    u8 enemy;
+    if (slot >= PARTY_SIZE || !GetMonData(&gPlayerParty[slot], MON_DATA_HP))
+        return;
+    for (enemy = 1; enemy < MAX_BATTLERS_COUNT; enemy += 2)
+        if (!(gAbsentBattlerFlags & (1 << enemy)) && gBattlerPartyIndexes[enemy] < PARTY_SIZE)
+            sParticipants[gBattlerPartyIndexes[enemy]] |= 1 << slot;
+}
+
+void MultiplayerRecordDefeat(u8 battler)
+{
+    u8 slot;
+    if (!MultiplayerCoopActive() || !(battler & 1))
+        return;
+    slot = gBattlerPartyIndexes[battler];
+    if (slot >= PARTY_SIZE || sDefeatedSpecies[slot])
+        return;
+    sDefeatedSpecies[slot] = GetMonData(&gEnemyParty[slot], MON_DATA_SPECIES);
+    sDefeatedLevel[slot] = GetMonData(&gEnemyParty[slot], MON_DATA_LEVEL);
+}
+
+static u8 HoldEffect(struct Pokemon *mon)
+{
+    u16 item = GetMonData(mon, MON_DATA_HELD_ITEM);
+    return item == ITEM_ENIGMA_BERRY ? gSaveBlock1Ptr->enigmaBerry.holdEffect : ItemId_GetHoldEffect(item);
+}
+
+void MultiplayerCommitRewards(MainCallback callback)
+{
+    u8 enemy, slot;
+    for (enemy = 0; enemy < PARTY_SIZE; enemy++)
+    {
+        u8 participants = 0, shares = 0;
+        u32 base;
+        if (!sDefeatedSpecies[enemy])
+            continue;
+        for (slot = 0; slot < gPlayerPartyCount; slot++)
+            if (GetMonData(&gPlayerParty[slot], MON_DATA_HP) && !GetMonData(&gPlayerParty[slot], MON_DATA_IS_EGG))
+            {
+                if (sParticipants[enemy] & (1 << slot)) participants++;
+                if (HoldEffect(&gPlayerParty[slot]) == HOLD_EFFECT_EXP_SHARE) shares++;
+            }
+        base = gSpeciesInfo[sDefeatedSpecies[enemy]].expYield * sDefeatedLevel[enemy] / 7;
+        for (slot = 0; slot < gPlayerPartyCount; slot++)
+        {
+            struct Pokemon *mon = &gPlayerParty[slot];
+            u32 exp = 0;
+            u8 effect = HoldEffect(mon);
+            if (!GetMonData(mon, MON_DATA_HP) || GetMonData(mon, MON_DATA_IS_EGG))
+                continue;
+            if ((sParticipants[enemy] & (1 << slot)) && participants)
+                exp = (shares ? base / 2 : base) / participants;
+            if (effect == HOLD_EFFECT_EXP_SHARE && shares)
+                exp += base / 2 / shares;
+            if (!exp)
+                continue;
+            MonGainEVs(mon, sDefeatedSpecies[enemy]);
+            if (effect == HOLD_EFFECT_LUCKY_EGG) exp = exp * 150 / 100;
+            if (gBattleTypeFlags & BATTLE_TYPE_TRAINER) exp = exp * 150 / 100;
+            if (IsTradedMon(mon)) exp = exp * 150 / 100;
+            sExperience[slot] += exp;
+        }
+    }
+    sRewardSlot = 0;
+    sRewardState = 0;
+    sLeveled = FALSE;
+    sRewardCallback = callback;
+    SetMainCallback2(CB2_Rewards);
+}
+
+static void CB2_ReturnFromMoveChoice(void)
+{
+    u8 slot = GetMoveSlotToReplace();
+    struct Pokemon *mon = &gPlayerParty[sRewardSlot];
+    if (slot < MAX_MON_MOVES)
+    {
+        u16 oldMove = GetMonData(mon, MON_DATA_MOVE1 + slot);
+        if (IsHMMove2(oldMove))
+        {
+            ShowSelectMovePokemonSummaryScreen(gPlayerParty, sRewardSlot, gPlayerPartyCount - 1,
+                CB2_ReturnFromMoveChoice, gMoveToLearn);
+            return;
+        }
+        RemoveMonPPBonus(mon, slot);
+        SetMonMoveSlot(mon, gMoveToLearn, slot);
+    }
+    SetMainCallback2(CB2_Rewards);
+}
+
+static void CB2_Rewards(void)
+{
+    struct Pokemon *mon;
+    u16 species, move;
+    u8 level;
+    u32 current, next;
+    if (sRewardSlot >= gPlayerPartyCount)
+    {
+        MultiplayerResetRewards();
+        SetMainCallback2(sRewardCallback);
+        return;
+    }
+    mon = &gPlayerParty[sRewardSlot];
+    if (sRewardState == 1)
+    {
+        move = MonTryLearningNewMove(mon, sFirstMove);
+        sFirstMove = FALSE;
+        if (move == MON_HAS_MAX_MOVES)
+        {
+            ShowSelectMovePokemonSummaryScreen(gPlayerParty, sRewardSlot, gPlayerPartyCount - 1,
+                CB2_ReturnFromMoveChoice, gMoveToLearn);
+            return;
+        }
+        if (move != MOVE_NONE)
+            return;
+        sRewardState = 0;
+    }
+    if (sRewardState == 2)
+    {
+        sRewardState = 0;
+        sLeveled = FALSE;
+        sRewardSlot++;
+        return;
+    }
+    level = GetMonData(mon, MON_DATA_LEVEL);
+    species = GetMonData(mon, MON_DATA_SPECIES);
+    if (sExperience[sRewardSlot] && level < MAX_LEVEL && species)
+    {
+        current = GetMonData(mon, MON_DATA_EXP);
+        next = gExperienceTables[gSpeciesInfo[species].growthRate][level + 1];
+        if (sExperience[sRewardSlot] >= next - current)
+        {
+            sExperience[sRewardSlot] -= next - current;
+            SetMonData(mon, MON_DATA_EXP, &next);
+            CalculateMonStats(mon);
+            AdjustFriendship(mon, FRIENDSHIP_EVENT_GROW_LEVEL);
+            sRewardState = 1;
+            sFirstMove = TRUE;
+            sLeveled = TRUE;
+            return;
+        }
+        current += sExperience[sRewardSlot];
+        SetMonData(mon, MON_DATA_EXP, &current);
+        sExperience[sRewardSlot] = 0;
+    }
+    if (sLeveled)
+    {
+        species = GetEvolutionTargetSpecies(mon, EVO_MODE_NORMAL, 0);
+        if (species)
+        {
+            sRewardState = 2;
+            gCB2_AfterEvolution = CB2_Rewards;
+            EvolutionScene(mon, species, TRUE, sRewardSlot);
+            return;
+        }
+    }
+    sLeveled = FALSE;
+    sRewardSlot++;
+}
