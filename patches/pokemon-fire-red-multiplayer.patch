--- a/src/field_specials.c
+++ b/src/field_specials.c
@@ -1522,10 +1522,48 @@ static const u16 sStarterSpecies[] = {
     SPECIES_CHARMANDER
 };
 
+static u16 GetRandomStarterChoice(u16 idx)
+{
+    if (idx >= 3)
+        idx = 0;
+    return VarGet(VAR_RANDOM_STARTER_1 + idx);
+}
+
+void RandomizeStarterChoices(void)
+{
+    u16 choices[3];
+    u16 species;
+    u8 i, j;
+
+    for (i = 0; i < ARRAY_COUNT(choices); i++)
+    {
+        do
+        {
+            // Species 1..NUM_SPECIES - 1 are valid Pokémon; NUM_SPECIES is Egg.
+            species = (Random() % (NUM_SPECIES - 1)) + 1;
+            for (j = 0; j < i && choices[j] != species; j++)
+                ;
+        } while (j < i);
+        choices[i] = species;
+        VarSet(VAR_RANDOM_STARTER_1 + i, species);
+    }
+}
+
+u16 GetRandomStarterSpecies(void)
+{
+    return GetRandomStarterChoice(gSpecialVar_0x8004);
+}
+
 static u16 GetStarterSpeciesById(u16 idx)
 {
     if (idx >= NELEMS(sStarterSpecies))
         idx = 0;
+    if (VarGet(VAR_STARTER_RANDOMIZER_MODE) == 1)
+    {
+        u16 species = GetRandomStarterChoice(idx);
+        if (species > SPECIES_NONE && species < NUM_SPECIES)
+            return species;
+    }
     return sStarterSpecies[idx];
 }
 
