diff --git a/src/multiplayer.c b/src/multiplayer.c
new file mode 100644
index 0000000..0d2377e
--- /dev/null
+++ b/src/multiplayer.c
@@ -0,0 +1,444 @@
+#include "global.h"
+#include "multiplayer.h"
+#include "event_object_movement.h"
+#include "field_player_avatar.h"
+#include "fieldmap.h"
+#include "palette.h"
+#include "quest_log.h"
+#include "script.h"
+#include "event_data.h"
+#include "main.h"
+#include "battle.h"
+#include "constants/event_objects.h"
+#include "constants/event_object_movement.h"
+#include "constants/quest_log.h"
+
+EWRAM_DATA volatile struct MultiplayerMailbox gMultiplayer = {0};
+static EWRAM_DATA u32 sLastSequence = 0;
+static EWRAM_DATA u32 sLastPacketFrame = 0;
+static EWRAM_DATA u32 sInvitationStarted = 0;
+static EWRAM_DATA u32 sLastIncomingInvitation = 0;
+static EWRAM_DATA u32 sPeerInvitationAtStart = 0;
+static EWRAM_DATA bool8 sInvitationUi = FALSE;
+static EWRAM_DATA bool8 sInvitationWaiting = FALSE;
+// Armed while the player is exploring. It is consumed by one wild encounter
+// so refusing an invitation can resume that same encounter as a solo battle.
+static EWRAM_DATA bool8 sCoopFieldEnabled = FALSE;
+
+enum {
+    INV_IDLE, INV_MENU, INV_OFFER, INV_PROMPT, INV_ACCEPT,
+    INV_CONFIRM, INV_ACK, INV_COMPLETE, INV_DECLINE, INV_CANCEL
+};
+
+extern const u8 EventScript_MultiplayerInvite[];
+extern const u8 EventScript_MultiplayerIncoming[];
+extern const u8 EventScript_MultiplayerUnavailable[];
+extern const u8 EventScript_MultiplayerWildInvite[];
+extern const u8 EventScript_MultiplayerTrainerInvite[];
+extern const u8 EventScript_MultiplayerTrainerTowerInvite[];
+static void UpdateInvitation(void);
+
+// Compile-time ABI check even with the original C compiler.
+typedef char MailboxSizeMustBe84[(sizeof(struct MultiplayerMailbox) == 84) ? 1 : -1];
+typedef char PositionSizeMustBe12[(sizeof(struct MultiplayerPosition) == 12) ? 1 : -1];
+
+void MultiplayerFrame(void)
+{
+    if (gMultiplayer.magic != MP_MAGIC)
+    {
+        gMultiplayer.version = MP_VERSION;
+        gMultiplayer.size = sizeof(gMultiplayer);
+        gMultiplayer.remoteObjectId = OBJECT_EVENTS_COUNT;
+        gMultiplayer.magic = MP_MAGIC;
+    }
+    gMultiplayer.frame++;
+    // Published again only by a playable overworld callback this frame.
+    gMultiplayer.local.ready = FALSE;
+    if (gMultiplayer.rxSequence != sLastSequence)
+    {
+        sLastSequence = gMultiplayer.rxSequence;
+        sLastPacketFrame = gMultiplayer.frame;
+    }
+    if (gMultiplayer.frame - sLastPacketFrame > 300)
+        gMultiplayer.connected = FALSE;
+    // The overworld callback can be paused by an invitation script or a map
+    // transition. Still let B and the deadline release a pending invitation.
+    if (sInvitationUi && gMultiplayer.inviteState > INV_IDLE
+     && gMultiplayer.inviteState < INV_COMPLETE
+     && (gMultiplayer.frame - sInvitationStarted > 1800
+         || ((sInvitationWaiting || gMultiplayer.inviteState == INV_OFFER
+              || gMultiplayer.inviteState == INV_ACCEPT)
+             && (gMain.heldKeysRaw & B_BUTTON))))
+        gMultiplayer.inviteState = INV_CANCEL;
+    if (sInvitationWaiting && gMultiplayer.inviteState >= INV_COMPLETE)
+    {
+        gMultiplayer.inviteResult = gMultiplayer.inviteState == INV_COMPLETE ? 2
+            : gMultiplayer.inviteState == INV_DECLINE ? 1 : 0;
+        gSpecialVar_Result = gMultiplayer.inviteResult;
+        sInvitationWaiting = FALSE;
+        ScriptContext_Enable();
+    }
+    MultiplayerDuelFrame();
+}
+
+static bool8 RemoteCanBeShown(void)
+{
+    s32 dx, dy;
+    if (!gMultiplayer.connected || !gMultiplayer.remote.ready)
+        return FALSE;
+    if (gMultiplayer.remote.mapGroup != gMultiplayer.local.mapGroup
+     || gMultiplayer.remote.mapNum != gMultiplayer.local.mapNum)
+        return FALSE;
+    if (gMultiplayer.remote.direction < DIR_SOUTH || gMultiplayer.remote.direction > DIR_EAST
+     || gMultiplayer.remote.elevation > 15 || gMultiplayer.remote.gender > 1)
+        return FALSE;
+    if (gMultiplayer.remote.x < MAP_OFFSET || gMultiplayer.remote.y < MAP_OFFSET
+     || gMultiplayer.remote.x >= gMapHeader.mapLayout->width + MAP_OFFSET
+     || gMultiplayer.remote.y >= gMapHeader.mapLayout->height + MAP_OFFSET)
+        return FALSE;
+    dx = (s32)gMultiplayer.remote.x - gMultiplayer.local.x;
+    dy = (s32)gMultiplayer.remote.y - gMultiplayer.local.y;
+    return dx >= -12 && dx <= 12 && dy >= -10 && dy <= 10;
+}
+
+static u8 GetRemoteAvatarGraphicsId(void)
+{
+    u8 state = PLAYER_AVATAR_GFX_NORMAL;
+    if (gMultiplayer.remote.avatarFlags & PLAYER_AVATAR_FLAG_SURFING)
+        state = PLAYER_AVATAR_GFX_RIDE;
+    else if (gMultiplayer.remote.avatarFlags & (PLAYER_AVATAR_FLAG_MACH_BIKE | PLAYER_AVATAR_FLAG_ACRO_BIKE))
+        state = PLAYER_AVATAR_GFX_BIKE;
+    return GetPlayerAvatarGraphicsIdByStateIdAndGender(state, gMultiplayer.remote.gender);
+}
+
+void MultiplayerOverworld(void)
+{
+    struct ObjectEvent *player;
+    struct ObjectEvent *remote;
+    struct ObjectEventTemplate template = {0};
+    u8 id, direction;
+    s32 dx, dy;
+
+    if (gPlayerAvatar.objectEventId >= OBJECT_EVENTS_COUNT)
+        return;
+    player = &gObjectEvents[gPlayerAvatar.objectEventId];
+    if (!player->active || !player->isPlayer || gPaletteFade.active || QL_IS_PLAYBACK_STATE)
+    {
+        if (gMultiplayer.remoteInviteState == INV_OFFER
+         && (gMultiplayer.remoteInvitation & MP_INVITATION_COOP))
+            UpdateInvitation();
+        MultiplayerRemoveRemote();
+        return;
+    }
+    if (ArePlayerFieldControlsLocked() && !sInvitationUi)
+    {
+        // A local wild/trainer script can lock controls one frame before the
+        // battle callback. Still process an incoming cooperative invitation.
+        if (gMultiplayer.remoteInviteState == INV_OFFER
+         && (gMultiplayer.remoteInvitation & MP_INVITATION_COOP))
+            UpdateInvitation();
+        MultiplayerRemoveRemote();
+        return;
+    }
+
+    gMultiplayer.local.mapGroup = gSaveBlock1Ptr->location.mapGroup;
+    gMultiplayer.local.mapNum = gSaveBlock1Ptr->location.mapNum;
+    gMultiplayer.local.x = player->currentCoords.x;
+    gMultiplayer.local.y = player->currentCoords.y;
+    gMultiplayer.local.direction = player->facingDirection;
+    gMultiplayer.local.elevation = player->currentElevation;
+    gMultiplayer.local.gender = gPlayerAvatar.gender;
+    gMultiplayer.local.avatarFlags = gPlayerAvatar.flags;
+    gMultiplayer.local.ready = TRUE;
+    // Re-arm only from the overworld. DoStandardWildBattle consumes this flag
+    // before opening the invitation, and the resumed solo battle therefore
+    // cannot immediately ask the same question again.
+    if (gMultiplayer.connected && !MultiplayerDuelActive())
+        sCoopFieldEnabled = TRUE;
+    UpdateInvitation();
+    if (!RemoteCanBeShown())
+    {
+        MultiplayerRemoveRemote();
+        return;
+    }
+
+    id = GetObjectEventIdByLocalIdAndMap(MP_LOCAL_ID,
+        gMultiplayer.local.mapNum, gMultiplayer.local.mapGroup);
+    if (id == OBJECT_EVENTS_COUNT)
+    {
+        template.localId = MP_LOCAL_ID;
+        // Reuse the game's player graphics table so gender and basic movement
+        // state match the avatar shown on the other emulator.
+        template.graphicsId = GetRemoteAvatarGraphicsId();
+        template.kind = OBJ_KIND_NORMAL;
+        template.x = gMultiplayer.remote.x - MAP_OFFSET;
+        template.y = gMultiplayer.remote.y - MAP_OFFSET;
+        template.objUnion.normal.elevation = gMultiplayer.remote.elevation;
+        template.objUnion.normal.movementType = MOVEMENT_TYPE_NONE;
+        id = SpawnSpecialObjectEvent(&template);
+    }
+    gMultiplayer.remoteObjectId = id;
+    if (id >= OBJECT_EVENTS_COUNT)
+        return; // Never evict a campaign NPC when all object slots are occupied.
+    remote = &gObjectEvents[id];
+    if (remote->graphicsId != GetRemoteAvatarGraphicsId())
+        ObjectEventSetGraphicsId(remote, GetRemoteAvatarGraphicsId());
+    remote->frozen = FALSE;
+    remote->invisible = FALSE;
+    if (ObjectEventIsHeldMovementActive(remote)
+     && !ObjectEventClearHeldMovementIfFinished(remote))
+        return;
+    dx = (s32)gMultiplayer.remote.x - remote->currentCoords.x;
+    dy = (s32)gMultiplayer.remote.y - remote->currentCoords.y;
+    if ((dx == 1 || dx == -1) && dy == 0)
+    {
+        direction = dx > 0 ? DIR_EAST : DIR_WEST;
+        ObjectEventSetHeldMovement(remote, GetWalkNormalMovementAction(direction));
+    }
+    else if ((dy == 1 || dy == -1) && dx == 0)
+    {
+        direction = dy > 0 ? DIR_SOUTH : DIR_NORTH;
+        ObjectEventSetHeldMovement(remote, GetWalkNormalMovementAction(direction));
+    }
+    else
+    {
+        if (dx || dy)
+            MoveObjectEventToMapCoords(remote, gMultiplayer.remote.x, gMultiplayer.remote.y);
+        SetObjectEventDirection(remote, gMultiplayer.remote.direction);
+    }
+    remote->currentElevation = gMultiplayer.remote.elevation;
+}
+
+static bool8 RemoteIsAdjacent(void)
+{
+    s32 dx, dy;
+    if (!RemoteCanBeShown())
+        return FALSE;
+    dx = (s32)gMultiplayer.remote.x - gMultiplayer.local.x;
+    dy = (s32)gMultiplayer.remote.y - gMultiplayer.local.y;
+    if (dx < 0) dx = -dx;
+    if (dy < 0) dy = -dy;
+    return dx + dy == 1
+        && gMultiplayer.remote.elevation == gMultiplayer.local.elevation;
+}
+
+// Automatic encounters can begin while the two avatars are several tiles apart
+// (for example when a trainer walks toward one player). Keep the explicit A
+// interaction strict, but allow a ten-tile cooperation radius here.
+static bool8 RemoteIsNearby(void)
+{
+    s32 dx, dy;
+    if (!RemoteCanBeShown()
+     || gMultiplayer.remote.elevation != gMultiplayer.local.elevation)
+        return FALSE;
+    dx = (s32)gMultiplayer.remote.x - gMultiplayer.local.x;
+    dy = (s32)gMultiplayer.remote.y - gMultiplayer.local.y;
+    if (dx < 0) dx = -dx;
+    if (dy < 0) dy = -dy;
+    return dx + dy <= 10;
+}
+
+static void BeginInvitation(void)
+{
+    // Role bit prevents simultaneous invitations from sharing an identifier.
+    gMultiplayer.invitation = ((gMultiplayer.frame & 0x1FFFFFFE) + 2)
+        | (gMultiplayer.role == 2);
+    gMultiplayer.inviteState = INV_MENU;
+    gMultiplayer.inviteResult = 0;
+    sPeerInvitationAtStart = gMultiplayer.remoteInvitation;
+    sInvitationStarted = gMultiplayer.frame;
+    sInvitationUi = TRUE;
+}
+
+const u8 *MultiplayerInteractionScript(void)
+{
+    if (sInvitationUi || !RemoteIsAdjacent() || !gMultiplayer.role)
+        return EventScript_MultiplayerUnavailable;
+    BeginInvitation();
+    return EventScript_MultiplayerInvite;
+}
+
+bool8 MultiplayerIsCoopInvitation(void)
+{
+    return (gMultiplayer.invitation & MP_INVITATION_COOP) != 0;
+}
+
+bool8 MultiplayerIsTrainerInvitation(void)
+{
+    return MultiplayerIsCoopInvitation()
+        && (gMultiplayer.invitation & MP_INVITATION_TRAINER) != 0;
+}
+
+bool8 MultiplayerIsRematchInvitation(void)
+{
+    return MultiplayerIsTrainerInvitation()
+        && (gMultiplayer.invitation & MP_INVITATION_REMATCH) != 0;
+}
+
+bool8 MultiplayerIsTowerInvitation(void)
+{
+    return MultiplayerIsTrainerInvitation()
+        && (gMultiplayer.invitation & MP_INVITATION_TOWER) != 0;
+}
+
+bool8 MultiplayerIsEncounterOwner(void)
+{
+    return MultiplayerIsCoopInvitation()
+        && (gMultiplayer.invitation & 1) == gMultiplayer.role - 1;
+}
+
+bool8 MultiplayerTryWildInvitation(void)
+{
+    if (!sCoopFieldEnabled || sInvitationUi || MultiplayerDuelActive()
+     || ScriptContext_IsEnabled() || !RemoteIsNearby()
+     || !gMultiplayer.role || !MultiplayerHasUsableParty())
+        return FALSE;
+    BeginInvitation();
+    gMultiplayer.invitation |= MP_INVITATION_COOP;
+    sCoopFieldEnabled = FALSE; // One encounter per explicit development activation.
+    ScriptContext_SetupScript(EventScript_MultiplayerWildInvite);
+    return TRUE;
+}
+
+static bool8 TryTrainerInvitation(u16 trainerId, bool8 rematch)
+{
+    if (sInvitationUi || MultiplayerDuelActive()
+     || !RemoteIsNearby() || !gMultiplayer.role || !MultiplayerHasUsableParty())
+        return FALSE;
+    BeginInvitation();
+    gMultiplayer.invitation = (gMultiplayer.frame & 0xFFFF)
+        | ((u32)(trainerId & 0x1FFF) << 16)
+        | MP_INVITATION_COOP | MP_INVITATION_TRAINER
+        | (rematch ? MP_INVITATION_REMATCH : 0)
+        | (gMultiplayer.role == 2);
+    ScriptContext_SetupScript(EventScript_MultiplayerTrainerInvite);
+    return TRUE;
+}
+
+bool8 MultiplayerTryTrainerInvitation(u16 trainerId)
+{
+    return TryTrainerInvitation(trainerId, FALSE);
+}
+
+bool8 MultiplayerTryRematchInvitation(u16 trainerId)
+{
+    return TryTrainerInvitation(trainerId, TRUE);
+}
+
+bool8 MultiplayerTryTowerInvitation(void)
+{
+    if (sInvitationUi || MultiplayerDuelActive() || !RemoteIsNearby()
+     || !gMultiplayer.role || !MultiplayerHasUsableParty())
+        return FALSE;
+    BeginInvitation();
+    gMultiplayer.invitation = (gMultiplayer.frame & 0xFFFF)
+        | MP_INVITATION_COOP | MP_INVITATION_TRAINER | MP_INVITATION_TOWER
+        | ((gBattleTypeFlags & BATTLE_TYPE_DOUBLE) ? MP_INVITATION_TOWER_DOUBLE : 0)
+        | (gMultiplayer.role == 2);
+    ScriptContext_SetupScript(EventScript_MultiplayerTrainerTowerInvite);
+    return TRUE;
+}
+
+void MultiplayerSendInvitation(void)
+{
+    if (gMultiplayer.inviteState == INV_MENU && RemoteIsNearby())
+    {
+        gMultiplayer.inviteState = INV_OFFER;
+        sInvitationStarted = gMultiplayer.frame;
+    }
+    else
+        gMultiplayer.inviteState = INV_CANCEL;
+}
+
+void MultiplayerAcceptInvitation(void)
+{
+    if (gMultiplayer.inviteState == INV_PROMPT && RemoteIsNearby()
+     && gMultiplayer.remoteInvitation == gMultiplayer.invitation
+     && gMultiplayer.remoteInviteState == INV_OFFER)
+        gMultiplayer.inviteState = INV_ACCEPT;
+    else
+        gMultiplayer.inviteState = INV_CANCEL;
+}
+
+void MultiplayerDeclineInvitation(void)
+{
+    if (gMultiplayer.inviteState == INV_PROMPT)
+        gMultiplayer.inviteState = INV_DECLINE;
+}
+
+void MultiplayerWaitInvitation(void)
+{
+    sInvitationWaiting = TRUE;
+}
+
+void MultiplayerFinishInvitation(void)
+{
+    if (gMultiplayer.inviteState < INV_COMPLETE)
+        gMultiplayer.inviteState = INV_CANCEL;
+    sInvitationUi = FALSE;
+    sInvitationWaiting = FALSE;
+    // Keep the terminal state until the next invitation. A slow peer must
+    // still receive the response after the local player closes the dialog.
+}
+
+static void UpdateInvitation(void)
+{
+    u8 state = gMultiplayer.inviteState;
+    u8 remote = gMultiplayer.remoteInviteState;
+    bool8 same = gMultiplayer.invitation == gMultiplayer.remoteInvitation;
+
+    if (sInvitationUi && state > INV_IDLE && state < INV_COMPLETE)
+    {
+        // The initiator may already be fading into battle after our ACK.
+        if (state == INV_ACK && same && remote == INV_COMPLETE && gMultiplayer.connected)
+            state = INV_COMPLETE;
+        else if (!RemoteIsNearby() || gMultiplayer.frame - sInvitationStarted > 1800
+         || (sInvitationWaiting && JOY_NEW(B_BUTTON)))
+            state = INV_CANCEL;
+        else if (!same && ((remote >= INV_MENU && remote <= INV_ACK)
+              || ((remote == INV_CANCEL || remote == INV_DECLINE)
+                  && gMultiplayer.remoteInvitation != sPeerInvitationAtStart)))
+            state = INV_CANCEL; // Simultaneous requests never imply consent.
+        else if (same)
+        {
+            if (remote == INV_CANCEL || remote == INV_DECLINE)
+                state = remote;
+            else if (state == INV_OFFER && remote == INV_ACCEPT)
+                state = INV_CONFIRM;
+            else if (state == INV_ACCEPT && remote == INV_CONFIRM)
+                state = INV_ACK;
+            else if (state == INV_CONFIRM && remote == INV_ACK)
+                state = INV_COMPLETE;
+            else if (state == INV_ACK && remote == INV_COMPLETE)
+                state = INV_COMPLETE;
+        }
+        gMultiplayer.inviteState = state;
+    }
+
+    if (state >= INV_COMPLETE)
+        gMultiplayer.inviteResult = state == INV_COMPLETE ? 2 : state == INV_DECLINE ? 1 : 0;
+    if (sInvitationWaiting && state >= INV_COMPLETE)
+    {
+        gSpecialVar_Result = gMultiplayer.inviteResult;
+        sInvitationWaiting = FALSE;
+        ScriptContext_Enable();
+    }
+
+    if (!sInvitationUi && remote == INV_OFFER && !same
+     && gMultiplayer.remoteInvitation != sLastIncomingInvitation
+     && RemoteIsNearby()
+     && ((gMultiplayer.remoteInvitation & MP_INVITATION_COOP)
+         || (!ArePlayerFieldControlsLocked()
+             && !ScriptContext_IsEnabled()
+             && gPlayerAvatar.tileTransitionState == T_NOT_MOVING)))
+    {
+        sLastIncomingInvitation = gMultiplayer.remoteInvitation;
+        sPeerInvitationAtStart = gMultiplayer.remoteInvitation;
+        gMultiplayer.invitation = gMultiplayer.remoteInvitation;
+        gMultiplayer.inviteState = INV_PROMPT;
+        gMultiplayer.inviteResult = 0;
+        sInvitationStarted = gMultiplayer.frame;
+        sInvitationUi = TRUE;
+        ScriptContext_SetupScript(EventScript_MultiplayerIncoming);
+    }
+}
diff --git a/src/multiplayer_battle.c b/src/multiplayer_battle.c
