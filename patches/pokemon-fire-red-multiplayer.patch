diff --git a/data/scripts/multiplayer.inc b/data/scripts/multiplayer.inc
new file mode 100644
index 0000000..675abce
--- /dev/null
+++ b/data/scripts/multiplayer.inc
@@ -0,0 +1,218 @@
+@ Private link duel: keep the field script paused until the battle returns.
+EventScript_MultiplayerInvite::
+	lockall
+	specialvar VAR_RESULT, MultiplayerHasUsableParty
+	compare VAR_RESULT, 0
+	goto_if_eq Multiplayer_NoParty
+	msgbox Multiplayer_Text_Invite, MSGBOX_YESNO
+	compare VAR_RESULT, YES
+	goto_if_eq Multiplayer_Send
+	goto Multiplayer_Close
+
+Multiplayer_Send:
+	special MultiplayerSendInvitation
+	goto Multiplayer_Wait
+
+EventScript_MultiplayerWildInvite::
+	lockall
+	msgbox Multiplayer_Text_WildInvite, MSGBOX_YESNO
+	compare VAR_RESULT, YES
+	goto_if_eq Multiplayer_Send
+	goto Multiplayer_ResumeWild
+
+EventScript_MultiplayerIncoming::
+	lockall
+	specialvar VAR_RESULT, MultiplayerHasUsableParty
+	compare VAR_RESULT, 0
+	goto_if_eq Multiplayer_NoParty
+	specialvar VAR_RESULT, MultiplayerIsCoopInvitation
+	compare VAR_RESULT, 1
+	goto_if_eq Multiplayer_IncomingCoopOrTrainer
+	msgbox Multiplayer_Text_Incoming, MSGBOX_YESNO
+	goto Multiplayer_IncomingAnswer
+Multiplayer_IncomingCoopOrTrainer:
+	specialvar VAR_RESULT, MultiplayerIsTrainerInvitation
+	compare VAR_RESULT, 1
+	goto_if_eq Multiplayer_IncomingTrainer
+Multiplayer_IncomingCoop:
+	msgbox Multiplayer_Text_IncomingCoop, MSGBOX_YESNO
+	goto Multiplayer_IncomingAnswer
+Multiplayer_IncomingTrainer:
+	msgbox Multiplayer_Text_IncomingTrainer, MSGBOX_YESNO
+Multiplayer_IncomingAnswer:
+	compare VAR_RESULT, YES
+	goto_if_eq Multiplayer_Accept
+	special MultiplayerDeclineInvitation
+	goto Multiplayer_Close
+
+Multiplayer_Accept:
+	special MultiplayerAcceptInvitation
+Multiplayer_Wait:
+	message Multiplayer_Text_Wait
+	waitmessage
+	special MultiplayerWaitInvitation
+	waitstate
+	compare VAR_RESULT, 2
+	goto_if_eq Multiplayer_Agreed
+	compare VAR_RESULT, 1
+	goto_if_eq Multiplayer_Declined
+	closemessage
+	goto Multiplayer_ResumeEncounterOrClose
+
+Multiplayer_Agreed:
+	closemessage
+	special MultiplayerFinishInvitation
+	special MultiplayerStartDuel
+	waitstate
+	specialvar VAR_0x8008, MultiplayerIsCoopInvitation
+	compare VAR_0x8008, 1
+	goto_if_eq Multiplayer_CoopFinished
+	compare VAR_RESULT, 0
+	goto_if_eq Multiplayer_DuelInterrupted
+	msgbox Multiplayer_Text_DuelFinished, MSGBOX_DEFAULT
+	goto Multiplayer_Close
+Multiplayer_CoopFinished:
+	compare VAR_RESULT, 0
+	goto_if_eq Multiplayer_CoopInterrupted
+	msgbox Multiplayer_Text_CoopFinished, MSGBOX_DEFAULT
+	goto Multiplayer_Close
+Multiplayer_CoopInterrupted:
+	msgbox Multiplayer_Text_CoopInterrupted, MSGBOX_DEFAULT
+	goto Multiplayer_Close
+Multiplayer_DuelInterrupted:
+	msgbox Multiplayer_Text_DuelInterrupted, MSGBOX_DEFAULT
+	goto Multiplayer_Close
+Multiplayer_NoParty:
+	special MultiplayerDeclineInvitation
+	msgbox Multiplayer_Text_NoParty, MSGBOX_DEFAULT
+	goto Multiplayer_Close
+Multiplayer_Declined:
+	msgbox Multiplayer_Text_Declined, MSGBOX_DEFAULT
+Multiplayer_ResumeEncounterOrClose:
+	specialvar VAR_RESULT, MultiplayerIsEncounterOwner
+	compare VAR_RESULT, 1
+	goto_if_eq Multiplayer_ResumeOwnedEncounter
+Multiplayer_Close:
+	special MultiplayerFinishInvitation
+	releaseall
+	end
+
+Multiplayer_ResumeOwnedEncounter:
+	specialvar VAR_RESULT, MultiplayerIsTowerInvitation
+	compare VAR_RESULT, 1
+	goto_if_eq Multiplayer_ResumeTrainerTower
+	specialvar VAR_RESULT, MultiplayerIsRematchInvitation
+	compare VAR_RESULT, 1
+	goto_if_eq Multiplayer_ResumeRematch
+	specialvar VAR_RESULT, MultiplayerIsTrainerInvitation
+	compare VAR_RESULT, 1
+	goto_if_eq Multiplayer_ResumeTrainer
+	goto Multiplayer_ResumeWild
+
+Multiplayer_ResumeWild:
+	closemessage
+	special MultiplayerFinishInvitation
+	releaseall
+	special MultiplayerResumeWildBattle
+	end
+
+EventScript_MultiplayerTrainerInvite::
+	lockall
+	msgbox Multiplayer_Text_TrainerInvite, MSGBOX_YESNO
+	compare VAR_RESULT, YES
+	goto_if_eq Multiplayer_Send
+	goto Multiplayer_ResumeTrainerOrClose
+
+Multiplayer_ResumeTrainerOrClose:
+	specialvar VAR_RESULT, MultiplayerIsEncounterOwner
+	compare VAR_RESULT, 1
+	goto_if_eq Multiplayer_ResumeTrainer
+	goto Multiplayer_Close
+
+Multiplayer_ResumeTrainer:
+	closemessage
+	special MultiplayerFinishInvitation
+	releaseall
+	special MultiplayerResumeTrainerBattle
+	end
+
+Multiplayer_ResumeRematch:
+	closemessage
+	special MultiplayerFinishInvitation
+	releaseall
+	special MultiplayerResumeRematchBattle
+	end
+
+Multiplayer_ResumeTrainerTower:
+	closemessage
+	special MultiplayerFinishInvitation
+	releaseall
+	special MultiplayerResumeTrainerTowerBattle
+	end
+
+EventScript_MultiplayerTrainerTowerInvite::
+	lockall
+	msgbox Multiplayer_Text_TrainerTowerInvite, MSGBOX_YESNO
+	compare VAR_RESULT, YES
+	goto_if_eq Multiplayer_Send
+	goto Multiplayer_ResumeTrainerTowerOrClose
+
+Multiplayer_ResumeTrainerTowerOrClose:
+	specialvar VAR_RESULT, MultiplayerIsEncounterOwner
+	compare VAR_RESULT, 1
+	goto_if_eq Multiplayer_ResumeTrainerTower
+	goto Multiplayer_Close
+
+EventScript_MultiplayerUnavailable::
+	lockall
+	msgbox Multiplayer_Text_Unavailable, MSGBOX_DEFAULT
+	releaseall
+	end
+
+Multiplayer_Text_Invite:
+	.string "Enviar convite de duelo?\n"
+	.string "Sua equipe sera restaurada depois.$"
+Multiplayer_Text_WildInvite:
+	.string "Selvagem: convidar seu amigo?\n"
+	.string "Cada um usa sua propria equipe.$"
+Multiplayer_Text_TrainerInvite:
+	.string "Treinador: convidar seu amigo?\n"
+    .string "A vitoria avanca esta campanha.$"
+Multiplayer_Text_TrainerTowerInvite:
+	.string "Torre de Treinadores: cooperar?\n"
+	.string "O resultado vale nesta campanha.$"
+Multiplayer_Text_IncomingCoop:
+	.string "Cooperar contra o selvagem?\n"
+	.string "Cada um usa sua propria equipe.$"
+Multiplayer_Text_IncomingTrainer:
+	.string "Cooperar contra este treinador?\n"
+	.string "Cada um usa sua propria equipe.$"
+Multiplayer_Text_CoopFinished:
+	.string "Batalha cooperativa encerrada.\n"
+	.string "HP, PP e EXP ficam na sua equipe.$"
+Multiplayer_Text_CoopInterrupted:
+	.string "Cooperacao interrompida.\n"
+	.string "Sua equipe foi restaurada.$"
+Multiplayer_Text_Incoming:
+	.string "Seu amigo convida para um duelo.\n"
+	.string "Aceitar o duelo?$"
+Multiplayer_Text_Wait:
+	.string "Aguardando seu amigo...\n"
+	.string "B (X): cancelar. Limite: 30s.$"
+Multiplayer_Text_DuelFinished:
+	.string "Duelo encerrado!\n"
+	.string "Sua equipe foi restaurada.$"
+Multiplayer_Text_DuelInterrupted:
+	.string "O duelo foi interrompido.\n"
+	.string "Sua equipe foi restaurada.$"
+Multiplayer_Text_NoParty:
+	.string "Voce precisa de um POKEMON\n"
+	.string "com HP para batalhar.$"
+Multiplayer_Text_Declined:
+	.string "Seu amigo recusou o convite.$"
+Multiplayer_Text_Cancelled:
+	.string "Convite cancelado ou expirado.\n"
+	.string "Aproxime-se e tente novamente.$"
+Multiplayer_Text_Unavailable:
+	.string "Seu amigo esta indisponivel.\n"
+	.string "Fique ao lado dele e tente de novo.$"
